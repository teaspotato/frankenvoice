+// A linear probe on the residual stream: p = sigmoid(w . l_out[layer] + b), from LLAMA_PROBE_FILE
+// (int32 layer, int32 n_embd, f32 b, f32 w[n_embd]). While a decode runs with the callback set, it scores
+// every row of the layer's output in order, so row i of a single-sequence batch is token i.
+struct server_probe {
+    int32_t layer = -1;
+    float bias = 0.0f;
+    std::vector<float> w;
+    std::string name; // "l_out-<layer>"
+    std::vector<float> scores;
+    std::vector<float> rows; // host copy of the layer output
+
+    bool load(const char * path, int32_t n_embd) {
+        FILE * f = fopen(path, "rb");
+        if (!f) {
+            return false;
+        }
+        int32_t n = 0;
+        bool ok = fread(&layer, sizeof(layer), 1, f) == 1 && fread(&n, sizeof(n), 1, f) == 1 &&
+                  fread(&bias, sizeof(bias), 1, f) == 1 && n == n_embd;
+        if (ok) {
+            w.resize(n);
+            ok = fread(w.data(), sizeof(float), n, f) == (size_t) n;
+        }
+        fclose(f);
+        name = "l_out-" + std::to_string(layer);
+        return ok;
+    }
+
+    static bool cb_eval(struct ggml_tensor * t, bool ask, void * user_data) {
+        auto * p = (server_probe *) user_data;
+        if (strcmp(t->name, p->name.c_str()) != 0) {
+            return ask ? false : true;
+        }
+        if (ask) {
+            return t->type == GGML_TYPE_F32 && t->ne[0] == (int64_t) p->w.size();
+        }
+        const int64_t n_embd = t->ne[0];
+        const int64_t n_rows = ggml_nrows(t);
+        p->rows.resize(n_embd * n_rows);
+        ggml_backend_tensor_get(t, p->rows.data(), 0, p->rows.size() * sizeof(float));
+        for (int64_t r = 0; r < n_rows; r++) {
+            const float * x = p->rows.data() + r * n_embd;
+            double s = p->bias;
+            for (int64_t i = 0; i < n_embd; i++) {
+                s += (double) p->w[i] * x[i];
+            }
+            p->scores.push_back((float) (1.0 / (1.0 + std::exp(-s))));
+        }
+        return true;
+    }
+};
