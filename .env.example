# Optional: everything here can also be set in the web UI (Settings), which
# overrides .env. Copy to .env to set values from a file. Never commit .env.
# Only the providers your graph uses need to be set; the toolbar shows what's missing.

# ASR
DEEPGRAM_API_KEY=

# LLM: Anthropic
ANTHROPIC_API_KEY=

# LLM / TTS: OpenAI-compatible endpoints (pick one in the node's "Endpoint" param)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# "custom": any OpenAI-compatible server (vLLM, Ollama, LM Studio, ...); key optional
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=

# TTS: Cartesia
CARTESIA_API_KEY=
# CARTESIA_VERSION=2025-04-16

# Override provider base URLs (e.g. a mock or self-hosted server):
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# DEEPGRAM_BASE_URL=wss://api.deepgram.com
# CARTESIA_BASE_URL=https://api.cartesia.ai
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# FV_SESSIONS_DIR=sessions
# Only settable here (the page needs it to find the proxy):
# FV_PROXY_PORT=8787
# FV_SETTINGS_FILE=.frankenvoice/settings.json
