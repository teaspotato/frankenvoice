# Optional: everything here can also be set in the web UI (Settings), which
# overrides .env. Copy to .env to set values from a file. Never commit .env.
# Only the services your pipeline uses need to be set; the toolbar shows what's missing.

# LLM: an OpenAI-compatible server (llama.cpp on the GPU box, vLLM, Ollama, ...); key optional
# OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8103/v1
# OPENAI_COMPAT_API_KEY=

# TypeSafe (opener, backchannels, interjection gate)
TYPESAFE_API_KEY=

# FV_SESSIONS_DIR=sessions
# Only settable here (the page needs it to find the proxy):
# FV_PROXY_PORT=8787
# FV_SETTINGS_FILE=.frankenvoice/settings.json

# GPU box (gpubox/server.py): Qwen3-ASR + Kyutai TTS
# GPUBOX_BASE_URL=wss://example.trycloudflare.com
# GPUBOX_TOKEN=
