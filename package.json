{
  "name": "frankenvoice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n proxy,web \"pnpm:dev:proxy\" \"pnpm:dev:web\"",
    "dev:web": "vite",
    "dev:proxy": "tsx watch server/index.ts",
    "build": "tsc -p . && vite build",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "replay-check": "tsx scripts/replay-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@ricky0123/vad-web": "^0.0.31",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "fflate": "^0.8.3",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "protobufjs"
    ]
  }
}
